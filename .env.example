# Copy these into Vercel: Project > Settings > Environment Variables.
# For local testing, copy this file to .env.local and fill it in.

# The public web address of the app (no trailing slash). Used in text links.
APP_URL=https://shiftready.staffselectionuk.com

# Supabase: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never share or put in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio: Console > Account info. Leave blank to run in "dry run" mode,
# where texts are logged in the app but not actually sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The UK mobile number you bought in Twilio, in +44 format. Needed so temps can reply YES / STOP.
TWILIO_FROM_NUMBER=

# WhatsApp (optional). Leave blank to send everything as texts. See WHATSAPP.md.
# The WhatsApp-enabled number, in +44 format (usually the same as TWILIO_FROM_NUMBER).
TWILIO_WHATSAPP_FROM=
# Twilio Content template ids (start HX...), one per message type.
WA_TEMPLATE_WELCOME=
WA_TEMPLATE_OFFER=
WA_TEMPLATE_REMINDER=
WA_TEMPLATE_PROMOTED=

# Secret used by the daily reminder job. Any long random string.
CRON_SECRET=
